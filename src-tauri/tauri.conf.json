{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 800,
        "minHeight": 640,
        "minWidth": 420,
        "resizable": true,
        "title": "DecoPlan",
        "width": 1100
      }
    ]
  },
  "build": {
    "beforeBuildCommand": "npx expo export --platform web",
    "beforeDevCommand": "npx expo start --web --port 8081",
    "devUrl": "http://localhost:8081",
    "frontendDist": "../dist"
  },
  "bundle": {
    "active": true,
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": "all"
  },
  "identifier": "com.jlblennie.DecoPlan",
  "productName": "DecoPlan",
  "mainBinaryName": "decoplan",
  "version": "0.1.0"
}