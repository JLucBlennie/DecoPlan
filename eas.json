{
  "build": {
    "apk-release": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal",
      "extends": "production"
    },
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "android": {
        "buildType": "apk"
      },
      "distribution": "internal"
    },
    "production": {
      "android": {
        "buildType": "app-bundle"
      },
      "autoIncrement": true
    }
  },
  "cli": {
    "appVersionSource": "remote",
    "version": ">= 18.3.0"
  },
  "submit": {
    "production": {
      "android": {
        "track": "internal"
      }
    }
  }
}